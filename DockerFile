# Step 1: Build Stage
FROM golang:1.22-alpine AS builder

WORKDIR /app

# Copy go mod files first to cache dependencies
COPY go.mod go.sum ./
RUN go mod download

# Copy the rest of the source code
COPY . .

# Build the application
# We target the main.go file in your server directory
RUN go build -o main ./cmd/server/main.go

# Step 2: Final Image Stage (Lightweight)
FROM alpine:latest

WORKDIR /root/

# Install certificates for SSL (Critical for connecting to Supabase!)
RUN apk --no-cache add ca-certificates

# Copy the binary from the builder
COPY --from=builder /app/main .

# Export the port
EXPOSE 8081

# Command to run
CMD ["./main"]