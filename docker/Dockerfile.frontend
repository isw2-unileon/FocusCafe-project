# syntax=docker/dockerfile:1

# Stage 1: Build de React con Vite
FROM node:20-alpine AS builder

WORKDIR /app

# Coyp package.json first to search dependencies
COPY frontend/package*.json ./
RUN npm ci

# Copy backend's remaining code
COPY frontend/ ./

# Environment's variables for building (from docker-compose)
ARG VITE_API_URL
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY

# Compile the app
RUN npm run build

# Stage 2: Serve with nginx
FROM nginx:alpine

# Copy static files compiles
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx's configuration
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
