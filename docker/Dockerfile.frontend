# syntax=docker/dockerfile:1

# Stage 1: Build de React con Vite
FROM node:20-alpine AS builder

WORKDIR /app

# Copiar package.json primero para cachear dependencias
COPY frontend/package*.json ./
RUN npm ci

# Copiar el resto del codigo del frontend
COPY frontend/ ./

# Variables de entorno para el build (se pasan desde docker-compose)
ARG VITE_API_URL
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY

# Compilar la aplicacion
RUN npm run build

# Stage 2: Servir con nginx
FROM nginx:alpine

# Copiar los archivos estaticos compilados
COPY --from=builder /app/dist /usr/share/nginx/html

# Copiar configuracion de nginx
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
