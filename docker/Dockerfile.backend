# syntax=docker/dockerfile:1

# Stage 1: Build
FROM golang:1.25-alpine AS builder

WORKDIR /app

# go.mod y go.sum in root's build context
COPY go.mod go.sum ./
RUN go mod download

# Copy backend's code
COPY backend/ ./backend/

# Compile the binary
RUN CGO_ENABLED=0 GOOS=linux go build -o server ./backend/cmd/server/main.go

# Stage 2: Final (light image)
FROM alpine:latest

WORKDIR /app

# Certificates CA for HTTPS (necessary for Supabase)
RUN apk --no-cache add ca-certificates

# Copy only the compiled binary
COPY --from=builder /app/server .

# Port that exposes the backend
EXPOSE 8080

# Start command
CMD ["./server"]
